{
 "strategies": [
  {
   "key": "F",
   "name": "Fixed 500, no overlap",
   "config": {
    "chunking": "fixed_size, no overlap",
    "chunk_size": 500,
    "overlap": 0,
    "scope": "per page"
   }
  },
  {
   "key": "A",
   "name": "Fixed 500 + overlap 50",
   "config": {
    "chunking": "fixed_size + overlap 10%",
    "chunk_size": 500,
    "overlap": 50,
    "scope": "per page"
   }
  },
  {
   "key": "D",
   "name": "Recursive 800/80",
   "config": {
    "chunking": "recursive (paragraph > line > sentence > word)",
    "chunk_size": 800,
    "overlap": 80,
    "scope": "per page"
   }
  },
  {
   "key": "B",
   "name": "Document structure",
   "config": {
    "chunking": "document structure (recital / Article / numbered paragraph / annex point) + context header",
    "chunk_size": 1200,
    "overlap": 0,
    "scope": "whole document, page..page_end"
   }
  },
  {
   "key": "S",
   "name": "Semantic (similarity breaks)",
   "config": {
    "chunking": "semantic: cut at lowest-percentile similarity between consecutive sentences",
    "max_size": 1200,
    "min_size": 200,
    "percentile": 10,
    "boundary_model": "BAAI/bge-small-en-v1.5",
    "scope": "per page"
   }
  },
  {
   "key": "L",
   "name": "Agentic LLM (Haiku, sample)",
   "config": {
    "chunking": "agentic: Claude Haiku 5.5 picks breakpoints on a SMALL SAMPLE of pages (gold pages + random); other pages use D",
    "llm_model": "claude-haiku-5-5",
    "random_pages": 5,
    "seed": 42,
    "max_size": 1200,
    "scope": "per page"
   }
  },
  {
   "key": "C",
   "name": "Structure + metadata filter",
   "config": {
    "chunking": "same index as B",
    "filter": true,
    "filter_fields": [
     "part"
    ],
    "note": "filter applied only to the 4 questions whose context supplies it"
   }
  }
 ],
